<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Print.in"
            android:textColor="#000000"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Broaden Your Collection"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="32dp"/>

        <!-- Input Nama Toko (Kuning Cerah) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="3dp"
            app:strokeColor="#000000"
            app:cardBackgroundColor="#FFC900"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etNamaToko"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@null"
                android:hint="Nama Toko"
                android:textColorHint="#424242"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:inputType="textPersonName"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Input Alamat (Pink Vibrant) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="3dp"
            app:strokeColor="#000000"
            app:cardBackgroundColor="#FF90E8"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etAlamat"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@null"
                android:hint="Alamat Lengkap"
                android:textColorHint="#424242"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:inputType="textPostalAddress"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Input Jenis Print (Cyan / Biru Muda) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="3dp"
            app:strokeColor="#000000"
            app:cardBackgroundColor="#00E5FF"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etJenisPrint"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@null"
                android:hint="Jenis Print (mis. A4 Warna)"
                android:textColorHint="#424242"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:inputType="text"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Input Harga (Ungu Pastel) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="3dp"
            app:strokeColor="#000000"
            app:cardBackgroundColor="#B4A0FF"
            android:layout_marginBottom="40dp">
            <EditText
                android:id="@+id/etHarga"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@null"
                android:hint="Harga per lembar (Rp)"
                android:textColorHint="#424242"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:inputType="number"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Simpan (Hijau Neon) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Start Now!"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#DDF247"
            app:strokeColor="#000000"
            app:strokeWidth="3dp"
            app:cornerRadius="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Tombol Lihat Data (Putih) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLihatData"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Buka Daftar Mitra"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#000000"
            app:strokeWidth="3dp"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>